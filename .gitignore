# Terminal / Desktop split: local venvs, build output and archives never enter git
.terminal-venv/
.terminal-test-venv/
node_modules/
*.dmg
/terminal/release/artifacts/
/release/artifacts/
/app/host/dist/
/app/desktop/src-tauri/target/
/app/desktop/src-tauri/resources/node/*
!/app/desktop/src-tauri/resources/node/.gitignore
# the Control component (bundled CPython + wheels + strata_control) is built by app/desktop/scripts/stage-control.py
/app/desktop/src-tauri/resources/control/*
!/app/desktop/src-tauri/resources/control/.gitignore
# the pruned DeepSeek Harness (MIT) is built by app/desktop/scripts/stage-harness.mjs
/app/desktop/src-tauri/resources/harness/*
!/app/desktop/src-tauri/resources/harness/.gitignore
# screenshots and checkpoints from the Mac rebuild live outside git (StrataSplit\evidence-archive)
/app/host/docs/evidence/
/app/host/docs/checkpoints/

# shared-backbone decision-policy exploration: generated examples, reports and captured vectors stay out of git.
# The source of truth is tools/decision_policy/make_examples.py; examples.jsonl and the reports are its output.
/tools/decision_policy/examples.jsonl
/tools/decision_policy/baseline_report.json
/tools/decision_policy/baseline_report.md
/tools/decision_policy/stage_a_report.json
/tools/decision_policy/stage_a_report.md
/tools/decision_policy/vectors/
# the tokenization and first-token studies: generated, and big (the first-token analysis is 200k lines).
# The tools that write them are the source of truth; the research doc says what they measured.
/tools/decision_policy/tokenization_results.json
/tools/decision_policy/first_token_analysis.json

# a launch config's BACKUP holds the same API key as the config it backs up, and /strata-*.json does not
# match a .bak: keep the backups out of git too.
/strata-*.json.bak

# DGX Spark build outputs and local venv (docs/DGX_SPARK_LINUX.md)
/terminal/out-spark/
/out-spark/
/terminal/build-spark/
/build-spark/
/terminal/build-vision-spark/
/build-vision-spark/
/terminal/.venv-build/
/.venv-build/
